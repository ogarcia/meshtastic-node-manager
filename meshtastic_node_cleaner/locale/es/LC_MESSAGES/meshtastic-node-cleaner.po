# Spanish translation for meshtastic-node-cleaner.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: es\n"

msgid "Meshtastic Node Cleaner"
msgstr "Meshtastic Node Cleaner"

msgid "Clean nodes from your device's nodedb"
msgstr "Limpia nodos del nodedb de tu dispositivo"

msgid "Device nodes — [bold red]{count}[/bold red] partially-known node(s) to be deleted [bold red]✗[/bold red]"
msgstr "Nodos del dispositivo — [bold red]{count}[/bold red] nodo(s) a medio conocer a eliminar [bold red]✗[/bold red]"

msgid "Device nodes — [bold red]{count}[/bold red] to be deleted, inactive for more than [bold yellow]{age}[/bold yellow] [bold red]✗[/bold red]"
msgstr "Nodos del dispositivo — [bold red]{count}[/bold red] a eliminar, sin actividad durante más de [bold yellow]{age}[/bold yellow] [bold red]✗[/bold red]"

msgid "✦ = partially known"
msgstr "✦ = a medio conocer"

msgid "#"
msgstr "#"

msgid "Node ID"
msgstr "ID de nodo"

msgid "Long name"
msgstr "Nombre largo"

msgid "Short"
msgstr "Corto"

msgid "Hardware"
msgstr "Hardware"

msgid "Last seen"
msgstr "Último contacto"

msgid "Ago"
msgstr "Hace"

msgid "entries (nodes with user.id only)"
msgstr "entradas (solo nodos con user.id)"

msgid "entries (all nodes)"
msgstr "entradas (todos los nodos)"

msgid "My node num"
msgstr "Mi nodo num"

msgid "nodedb summary"
msgstr "Resumen nodedb"

msgid "nodesByNum is empty"
msgstr "nodesByNum está vacío"

msgid "Full nodesByNum content"
msgstr "Contenido completo de nodesByNum"

msgid "num (hex)"
msgstr "num (hex)"

msgid "in nodes?"
msgstr "¿en nodes?"

msgid "me"
msgstr "yo"

msgid "Nodes marked ✗ in 'in nodes?' are hidden without --debug"
msgstr "Nodos marcados con ✗ en '¿en nodes?' son invisibles sin --debug"

msgid "[bold green]{success}[/bold green] of [bold]{total}[/bold] node(s) removed."
msgstr "[bold green]{success}[/bold green] de [bold]{total}[/bold] nodo(s) eliminado(s)."

msgid "Result"
msgstr "Resultado"

msgid "Never seen"
msgstr "Nunca visto"

msgid "Invalid duration format: '{value}'. Use e.g. 30m, 24h, 7d, 2w"
msgstr "Formato de duración inválido: '{value}'. Usa, p.ej., 30m, 24h, 7d, 2w"

msgid "Remove nodes from a Meshtastic device's nodedb."
msgstr "Elimina nodos del nodedb de un dispositivo Meshtastic."

msgid "Examples:\n  %(prog)s --host 192.168.1.10 --older-than 7d\n  %(prog)s --device /dev/ttyUSB0 --older-than 24h\n  %(prog)s --host 192.168.1.10 --purge-unknown"
msgstr "Ejemplos:\n  %(prog)s --host 192.168.1.10 --older-than 7d\n  %(prog)s --device /dev/ttyUSB0 --older-than 24h\n  %(prog)s --host 192.168.1.10 --purge-unknown"

msgid "Connect via TCP"
msgstr "Conectar vía TCP"

msgid "Connect via serial (e.g. /dev/ttyUSB0)"
msgstr "Conectar vía serial (p.ej. /dev/ttyUSB0)"

msgid "TCP port (default: 4403)"
msgstr "Puerto TCP (default: 4403)"

msgid "Delete all nodes (known and unknown) with no activity for longer than this duration (e.g. 30m, 24h, 7d, 2w). Default: 7d"
msgstr "Elimina todos los nodos (conocidos y desconocidos) sin actividad durante más de este tiempo (p.ej. 30m, 24h, 7d, 2w). Default: 7d"

msgid "Delete only partially-known nodes (those without complete NodeInfo), regardless of age"
msgstr "Elimina solo los nodos a medio conocer (sin NodeInfo completo), independientemente de su antigüedad"

msgid "Column to sort by. Choices: {choices}. Default: date"
msgstr "Columna de ordenación. Opciones: {choices}. Default: date"

msgid "Reverse the sort order. For 'date': show oldest first. For 'name'/'id'/'hardware': Z→A order"
msgstr "Invierte el orden. Para 'date': muestra los más antiguos primero. Para 'name'/'id'/'hardware': orden Z→A"

msgid "Skip confirmation prompt and delete immediately"
msgstr "No pedir confirmación, borrar directamente"

msgid "Increase verbosity. Use -v for INFO-level output (connection details, node counts) and -vv for DEBUG-level output (full nodedb dump, raw processing info)"
msgstr "Aumenta la verbosidad. Usa -v para salida INFO (detalles de conexión, conteos) y -vv para salida DEBUG (volcado completo del nodedb, información de procesamiento)"

msgid "Connecting via TCP to"
msgstr "Conectando vía TCP a"

msgid "Connecting via serial to"
msgstr "Conectando vía serial a"

msgid "Serial port detected:"
msgstr "Puerto serial detectado:"

msgid "Multiple serial ports detected:"
msgstr "Múltiples puertos seriales detectados:"

msgid "Using [bold]{port}[/bold]. Use --device to specify another."
msgstr "Usando [bold]{port}[/bold]. Usa --device para especificar otro."

msgid "No serial device detected. Trying TCP on localhost…"
msgstr "No se detectó ningún dispositivo serial. Intentando TCP en localhost…"

msgid "Connection error:"
msgstr "Error de conexión:"

msgid "Fetching node list…"
msgstr "Obteniendo lista de nodos…"

msgid "The device has no nodes in its nodedb."
msgstr "El dispositivo no tiene nodos en su nodedb."

msgid "All clean!"
msgstr "¡Todo limpio!"

msgid "No partially-known nodes found."
msgstr "No hay nodos a medio conocer."

msgid "No nodes inactive for more than [yellow]{age}[/yellow]."
msgstr "No hay nodos sin actividad hace más de [yellow]{age}[/yellow]."

msgid "About to remove [red]{count}[/red] of [white]{total}[/white] node(s)."
msgstr "Se van a eliminar [red]{count}[/red] de [white]{total}[/white] nodo(s)."

msgid "Confirm deletion?"
msgstr "¿Confirmas la eliminación?"

msgid "Removed: [cyan]{node_id}[/cyan] ({name})"
msgstr "Eliminado: [cyan]{node_id}[/cyan] ({name})"

msgid "Error removing {node_id}: {exc}"
msgstr "Error eliminando {node_id}: {exc}"

msgid "Operation cancelled. No nodes were removed."
msgstr "Operación cancelada. No se eliminó ningún nodo."

msgid "Force serial connection. DEVICE (e.g. /dev/ttyUSB0) is optional; if omitted, serial ports are auto-detected. Never falls back to TCP"
msgstr "Fuerza conexión serial. DEVICE (p.ej. /dev/ttyUSB0) es opcional; si se omite, se auto-detectan los puertos seriales. Nunca usa TCP como alternativa"

msgid "Force TCP connection. HOST can be a hostname, host:port, or http://host:port URL. Defaults to localhost if omitted. Never falls back to serial"
msgstr "Fuerza conexión TCP. HOST puede ser un hostname, host:puerto o URL http://host:puerto. Por defecto usa localhost si se omite. Nunca usa serial como alternativa"

msgid "No serial device found. Connect a device or use -t / --tcp to connect via TCP."
msgstr "No se encontró ningún dispositivo serial. Conecta un dispositivo o usa -t / --tcp para conectar por TCP."

msgid "Using [bold]{port}[/bold]. Use --serial to specify another."
msgstr "Usando [bold]{port}[/bold]. Usa --serial para especificar otro."

msgid "Host cannot be empty. Use e.g. 192.168.1.10 or 192.168.1.10:5000"
msgstr "El host no puede estar vacío. Usa p.ej. 192.168.1.10 o 192.168.1.10:5000"

msgid "Invalid host: '{value}'"
msgstr "Host inválido: '{value}'"

msgid "Examples:\n  %(prog)s                           # auto-detect\n  %(prog)s -s                        # force serial, auto-detect port\n  %(prog)s -s /dev/ttyUSB0           # force serial, specific device\n  %(prog)s -t                        # force TCP, localhost\n  %(prog)s -t 192.168.1.10           # force TCP, specific host\n  %(prog)s -t 192.168.1.10:5000      # force TCP, host + port\n  %(prog)s -t 192.168.1.10 --older-than 24h\n  %(prog)s -s --purge-unknown"
msgstr "Ejemplos:\n  %(prog)s                           # auto-detectar\n  %(prog)s -s                        # forzar serial, auto-detectar puerto\n  %(prog)s -s /dev/ttyUSB0           # forzar serial, dispositivo específico\n  %(prog)s -t                        # forzar TCP, localhost\n  %(prog)s -t 192.168.1.10           # forzar TCP, host específico\n  %(prog)s -t 192.168.1.10:5000      # forzar TCP, host + puerto\n  %(prog)s -t 192.168.1.10 --older-than 24h\n  %(prog)s -s --purge-unknown"

msgid "to delete?"
msgstr "¿borrar?"
